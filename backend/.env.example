# Copy to backend/.env (gitignored). Never commit real keys.
GEMINI_API_KEY=

# Cheap + fast. Check the exact model id in AI Studio's model list.
GEMINI_MODEL=gemini-3.7-flash
# minimal | low | high. Thinking tokens are billed as output, so keep low. Leave empty if the model rejects it.
GEMINI_THINKING_LEVEL=low

PORT=8787
# Only needed when frontend is served from another origin (e.g. deployed).
CORS_ORIGIN=http://localhost:5173
